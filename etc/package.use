# /etc/bpm/package.use - per package use flags, applied after BPM_USE
#
#    <pattern>    <flags ...>
#
# the pattern is matched against the package name with shell globbing, so a
# line may cover a whole family of packages
#
# later lines add to earlier ones
#
# examples:
#    mpv        x11 wayland pulseaudio -lua
#    ffmpeg        x264 x265 vpx -nls
#    *-gtk        x11 wayland
#    git        -perl doc
