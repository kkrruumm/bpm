#!/bin/sh
#
# bpm - basix package manager
#
set -eu

BPM_PROGVER=0.7

# where the fuck am i so we can re-exec into the sandbox and into root
case $0 in
    */*) _dir=$(cd "${0%/*}" && pwd); BPM_SELF=$_dir/${0##*/} ;;
    *) BPM_SELF=$(command -v "$0"); _dir=${BPM_SELF%/*} ;;
esac
if [ -d "$_dir/lib/style" ]; then : "${BPM_LIBDIR:=$_dir/lib}"; fi
: "${BPM_LIBDIR:=/usr/lib/bpm}"
: "${BPM_CONF:=/etc/bpm/bpm.conf}"

# BPM_LIBDIR has to come from the environment because the library is needed here,
# which is way before bpm.conf is read
if [ ! -f "$BPM_LIBDIR/common.sh" ]; then
    printf 'bpm: no library found at %s\n' "$BPM_LIBDIR" >&2
    printf 'bpm: set BPM_LIBDIR in the environment (bpm.conf is read too late)\n' >&2
    exit 1
fi

. "$BPM_LIBDIR/common.sh"
. "$BPM_LIBDIR/pkg.sh"
. "$BPM_LIBDIR/account.sh"
config_load

usage() {
    cat >&2 <<EOF
bpm $BPM_PROGVER - basix package manager

usage: bpm <command> [argument ...]

  [b]uild    pkg...   build packages and any missing dependencies
  [i]nstall  pkg...   build if needed, then install into \$BPM_ROOT
  [r]emove   pkg...   remove installed packages, -a also removes the orphans
                      that leaves behind, -f skips the reverse dependency check
  autoremove          remove every orphaned package, -n lists them instead,
                      -y skips the prompt
  [u]pdate            pull repositories, rebuild and install what changed
  [p]ull              clone or pull repositories only
  [s]earch   pattern  search repositories (globs allowed)
  [q]uery    pkg      show template metadata and resolved use flags
  [a]lternatives      list alternatives, or bpm a <pkg> <path> to swap
  verify     [pkg...] list files that no longer match what was packaged,
                      -c includes config files, --overwrite <pkg> <path>
                      restores the specified file from the archive
  [l]ist     [-r] [pkg]
                      list installed packages, -r appends the reason each package
                      was installed
  [f]iles    pkg      list files owned by an installed package
  [o]wns     path     show which package owns a path
  [c]hecksum [-w] pkg print blake3 sums of the dist_files (-w rewrites template)
  [d]ownload pkg...   fetch dist_files only
  clean [all]         remove build trees and staged destdirs, "all" also
                      removes the build root base
  [h]elp, [v]ersion

config: $BPM_CONF
repos:  $BPM_REPOS
build:  ${BPM_BUILDROOT:-host}
EOF
    exit "${1:-1}"
}

# builds run in fresh mount, pid, ipc, uts and (unless the template enables
# network access) network namespaces via unshare
#
# unprivileged users also get a user namespace, uid 0 inside is the caller outside
# so the build can chown to root and write its dest_dir while every file owned by
# the real root maps to an unmapped uid and stays unwritable
#
# with BPM_BUILDROOT set what lands in here is __stage, which uses the mount
# namespace to assemble a root of its own and chroots into it, without it the
# build runs against the hosts / which is IMO unclean

sandbox() {
    if [ "$BPM_SANDBOX" = 0 ]; then
        _sb_st=0
        "$@" || _sb_st=$?
        return "$_sb_st"
    fi
    have unshare || die "unshare(1) not found; install util-linux/busybox or set BPM_SANDBOX=0"

    _u="--mount --pid --fork --ipc --uts --mount-proc"
    BPM_USERNS=0
    if [ "$(id -u)" != 0 ]; then
        _u="$_u --user --map-root-user"
        BPM_USERNS=1
    fi
    if [ "${allow_network:-no}" != yes ]; then _u="$_u --net"; fi
    export BPM_USERNS

    unshare $_u -- "$@"
}

# build shit

# a build root is populated from binary packages, so everything that goes into
# one has to exist as a binary package first, which shouldn't be an issue because
# in theory the system bpm is run against was built off of a basix tarball with the
# base system already built, so missing a base package is a hard error
broot_require_base() {
    [ -n "$BPM_BASEPKGS" ] ||
        die "BPM_BUILDROOT is set but BPM_BASEPKGS is empty, nothing to build in"
    _miss=
    # shellcheck disable=SC2086
    for _bm in $(rdeps_closure $BPM_BASEPKGS); do
        ar_current "$_bm" || _miss="$_miss $_bm"
    done
    [ -z "$_miss" ] || die "no current binary package for build root base:$_miss
    these have to be built against the host once, e.g.:
        BPM_BUILDROOT= bpm build$_miss"
}

# build whatever the build root for <pkg> will need and does not have yet
broot_prebuild() {
    case " ${BPM_BUILDING:-} " in
        *" $1 "*) die "$1: dependency cycle in make_depends" ;;
    esac
    BPM_BUILDING="${BPM_BUILDING:-} $1"

    broot_require_base
    # populating the base needs uid 0 as much as the build does, but it is
    # shared, so it happens once per run and outside of any packages build log
    if [ "${BPM_BASE_READY:-0}" = 0 ]; then
        sandbox "$BPM_SELF" __base || die "failed to populate the build root base"
        BPM_BASE_READY=1
    fi

    # shellcheck disable=SC2046
    for _bd in $(rdeps_closure $(tmpl_get "$1" make_depends)); do
        ar_current "$_bd" || build_one "$_bd"
    done

    BPM_BUILDING=${BPM_BUILDING%" $1"}
}

# if theres not a defined buildroot the build will be running on the hosts /
# so the makedepends *have* to be installed on the host but
# require interaction for this so this isnt a hidden installation of
# build only dependencies
host_require_makedeps() {
    _miss=
    # shellcheck disable=SC2046
    for _hd in $(rdeps_closure $(tmpl_get "$1" make_depends)); do
        pkg_installed "$_hd" || _miss="$_miss $_hd"
    done
    [ -z "$_miss" ] || die "$1: BPM_BUILDROOT is unset and makedepends are missing:$_miss
    set BPM_BUILDROOT in $BPM_CONF so they can be built into a throwaway root
    or put them on the host intentionally with:
        bpm install$_miss"
}

build_one() {
    if [ -n "$BPM_BUILDROOT" ]; then
        broot_prebuild "$1"
    else
        host_require_makedeps "$1"
    fi

    tmpl_load "$1"
    if [ -f "$pkg_ar" ] && [ "$BPM_FORCE" = 0 ]; then
        # the archive records the flags it was built with, so a use flag
        # change invalidates it just like a version bump does
        _was=$(ar_member "$pkg_ar" "./var/db/bpm/installed/$pkg_name/use" 2>/dev/null || echo)
        if [ "$_was" = "$(use_effective)" ]; then
            sub "$pkg_name-$pkg_ver is already built"
            return 0
        fi
        sub "$pkg_name: use flags changed to \"$(use_effective)\", rebuilding"
    fi
    # fetching happens out here because the sandbox probably has no network
    if have do_fetch; then do_fetch; else src_fetch; fi
    src_verify

    msg "building $pkg_name-$pkg_ver [$build_style] use: $(use_effective)"
    _log=$BPM_LOGDIR/$pkg_name.log
    _st=0
    run_logged "$pkg_name-$pkg_ver" "$_log" sandbox "$BPM_SELF" __stage "$pkg_name" || _st=$?

    # the mounts died with the namespace, this is only the overlay upper layer
    if [ -n "$BPM_BUILDROOT" ] && [ "$BPM_BROOT_KEEP" = 0 ]; then
        rm -rf "${BPM_BUILDROOT:?}/$pkg_name"
    fi
    [ "$_st" = 0 ] || die "$pkg_name: build failed, full log in $_log"
}

cmd_build() {
    [ $# -gt 0 ] || usage
    _order=$(deps_order "$@")
    msg "build order: $_order"
    for _p in $_order; do build_one "$_p"; done
}

cmd_install() {
    [ $# -gt 0 ] || usage
    _order=$(deps_order "$@")
    msg "install order: $_order"
    for _p in $_order; do build_one "$_p"; done

    # what the user entered is explicit, whatever deps_order appended isnt
    # so removing the one thing that *was* wanted makes the rest collectable
    # BPM_MARK is so updates don't fuck with install reasons
    _named=" $* "
    _args= _last=
    for _p in $_order; do
        tmpl_load "$_p"
        pkg_save_old "$_p"
        case $_named in
            *" $_p "*) _m=${BPM_MARK:-explicit} ;;
            *) _m=auto ;;
        esac
        if [ "$_m" != "$_last" ]; then _args="$_args --$_m"; _last=$_m; fi
        _args="$_args $pkg_ar"
    done
    # shellcheck disable=SC2086
    as_root "$BPM_SELF" __install $_args
}

cmd_remove() {
    _sweep=$BPM_AUTOREMOVE _force=0
    while [ $# -gt 0 ]; do
        case $1 in
            -a|--autoremove) _sweep=1 ;;
            -A|--no-autoremove) _sweep=0 ;;
            -f|--force) _force=1 ;;
            --) shift; break ;;
            -*) die "unknown option: $1 (try 'bpm help')" ;;
            *) break ;;
        esac
        shift
    done
    [ $# -gt 0 ] || usage
    for _p; do pkg_installed "$_p" || die "$_p is not installed"; done

    # packages left behind that depend on something that's about to get thanos snapped
    # anything else in the same removal doesnt count
    if [ "$_force" = 0 ]; then
        BPM_OMIT=$*
        _held=
        for _p; do
            for _r in $(pkg_rdeps "$_p"); do _held="$_held $_r->$_p"; done
        done
        BPM_OMIT=
        [ -z "$_held" ] || die "these would be left with missing dependencies:$_held
    remove them too, or pass -f to do it anyway"
    fi

    # the sweep gets put into the same removal instead of running after it so there's
    # only one escalation and pass over the disk
    _rm=$*
    if [ "$_sweep" = 1 ]; then
        _orph=$(pkg_orphans "$@" | tr '\n' ' ')
        if [ -n "$_orph" ]; then
            msg "also removing orphaned: $_orph"
            _rm="$_rm $_orph"
        fi
    fi

    # shellcheck disable=SC2086
    _rm=$(remove_order $_rm)
    # shellcheck disable=SC2086
    as_root "$BPM_SELF" __remove $_rm

    if [ "$_sweep" = 0 ]; then
        _orph=$(pkg_orphans | tr '\n' ' ')
        if [ -n "$_orph" ]; then
            _n=0
            for _p in $_orph; do _n=$((_n + 1)); done
            warn "$_n package(s) are now orphaned, remove them with 'bpm autoremove'"
        fi
    fi
}

cmd_autoremove() {
    _dry=0 _yes=0
    while [ $# -gt 0 ]; do
        case $1 in
            -n|--dry-run) _dry=1 ;;
            -y|--yes) _yes=1 ;;
            --) shift; break ;;
            -*) die "unknown option: $1 (try 'bpm help')" ;;
            *) break ;;
        esac
        shift
    done
    [ $# -eq 0 ] || die "autoremove takes no package arguments (try 'bpm help')"

    _orph=$(pkg_orphans | tr '\n' ' ')
    if [ -z "$_orph" ]; then msg "no orphaned packages"; return 0; fi

    # shellcheck disable=SC2086
    _orph=$(remove_order $_orph)
    _n=0
    for _p in $_orph; do _n=$((_n + 1)); done
    msg "$_n orphaned package(s):"
    for _p in $_orph; do sub "$_p $(cat "$BPM_DB/$_p/version")"; done
    [ "$_dry" = 0 ] || return 0

    # the remove list bpm decides on isn't explicitly entered by the user
    # so this requires confirmation from the user unless -y
    if [ "$_yes" = 0 ]; then
        [ -t 0 ] || die "not a terminal, pass -y to remove these"
        printf 'remove these? [y/N] ' >&2
        read -r _a || _a=
        case $_a in
            y|Y|yes|YES) ;;
            *) msg "nothing removed"; return 0 ;;
        esac
    fi

    # shellcheck disable=SC2086
    as_root "$BPM_SELF" __remove $_orph
}

# repository shit

cmd_pull() {
    [ -r "$BPM_REPOCONF" ] || die "no repository list at $BPM_REPOCONF"
    while read -r name url branch; do
        case $name in ''|\#*) continue ;; esac
        case $url in /*) continue ;; esac
        _d=$BPM_REPODIR/$name
        if [ -d "$_d/.git" ]; then
            msg "pulling $name"
            git -C "$_d" pull -q --ff-only
        else
            msg "cloning $name from $url"
            mkdir -p "${_d%/*}"
            git clone -q ${branch:+--branch "$branch"} "$url" "$_d"
        fi
    done < "$BPM_REPOCONF"
}

cmd_update() {
    cmd_pull
    _out=
    for _d in "$BPM_DB"/*/; do
        [ -f "$_d/version" ] || continue
        _p=${_d%/}; _p=${_p##*/}
        if ! pkg_find "$_p" >/dev/null; then
            warn "$_p: no longer in any repository"
            continue
        fi
        _oldv=$(cat "$_d/version")
        _oldu=$(cat "$_d/use" 2>/dev/null || echo)
        tmpl_load "$_p"
        if [ "$_oldv" != "$pkg_ver" ] || [ "$_oldu" != "$(use_effective)" ]; then
            _out="$_out $_p"
        fi
    done
    if [ -z "$_out" ]; then msg "everything is up to date"; return 0; fi
    msg "to update:$_out"
    # an update isnt a request for any of these, a package that got pulled as a dep
    # stays a dep after it's rebuilt
    BPM_MARK=keep
    # shellcheck disable=SC2086
    cmd_install $_out
    BPM_MARK=explicit
}

# query shit

cmd_search() {
    [ $# -gt 0 ] || usage
    for _r in $BPM_REPOS; do
        for _d in "$_r"/*/; do
            [ -f "$_d/template" ] || continue
            _n=${_d%/}; _n=${_n##*/}
            # shellcheck disable=SC2254
            case $_n in $1|*$1*) printf '%s\t%s\n' "$_n" "$_r" ;; esac
        done
    done
}

cmd_query() {
    [ $# -gt 0 ] || usage
    tmpl_load "$1"
    printf 'pkg_name    %s\nversion     %s\nrevision    %s\nbuild_style %s\n' \
        "$pkg_name" "$version" "$revision" "$build_style"
    printf 'short_desc  %s\nhome_page   %s\nlicense     %s\n' \
        "${short_desc:-}" "${home_page:-}" "${license:-}"
    printf 'depends     %s\nmakedepends %s\n' "${depends:-}" "${make_depends:-}"
    printf 'use_flags   %s\nuse         %s\n' "${use_flags:-}" "$(use_effective)"
    if [ -n "${system_accounts:-}${system_groups:-}" ]; then
        printf 'accounts    %s\ngroups      %s\n' "${system_accounts:-}" "${system_groups:-}"
    fi
    printf 'template    %s\n' "$tmpl_dir/template"
    if pkg_installed "$1"; then
        printf 'installed   %s (%s)\n' "$(cat "$BPM_DB/$1/version")" "$(pkg_reason "$1")"
        _rd=$(pkg_rdeps "$1" | tr '\n' ' ')
        printf 'required by %s\n' "${_rd:-nothing}"
    fi
}

cmd_list() {
    _lr=0
    if [ "${1:-}" = -r ]; then _lr=1; shift; fi
    if [ "$_lr" = 1 ]; then
        # shellcheck disable=SC2046
        [ $# -gt 0 ] || set -- $(pkg_all)
        for _p; do
            pkg_installed "$_p" || die "$_p is not installed"
            printf '%s %s %s\n' "$_p" "$(cat "$BPM_DB/$_p/version")" "$(pkg_reason "$_p")"
        done
        return 0
    fi
    if [ $# -gt 0 ]; then
        for _p; do
            pkg_installed "$_p" || die "$_p is not installed"
            printf '%s %s\n' "$_p" "$(cat "$BPM_DB/$_p/version")"
        done
        return 0
    fi
    for _d in "$BPM_DB"/*/; do
        [ -f "$_d/version" ] || continue
        _p=${_d%/}
        printf '%s %s\n' "${_p##*/}" "$(cat "$_d/version")"
    done
}

cmd_alternatives() {
    if [ $# -eq 0 ]; then pkg_list_alternatives; return 0; fi
    [ $# -eq 2 ] || die "usage: bpm alternatives [<pkg> <path>]"
    as_root "$BPM_SELF" __swap "$1" "$2"
}

# pretty much same usage style as alternatives
# in theory this should be a good way to restore
# broken/corrupted shit from packages if they still
# exist in the package archive, this is not useful for
# detecting tampering or anything though (nongoal)
cmd_verify() {
    _ow=0
    BPM_VERIFY_CONFIG=0
    BPM_VERIFY_NOSUMS=0
    while [ $# -gt 0 ]; do
        case $1 in
            -c|--config) BPM_VERIFY_CONFIG=1 ;;
            -o|--overwrite) _ow=1 ;;
            --) shift; break ;;
            -*) die "unknown option: $1 (try 'bpm help')" ;;
            *) break ;;
        esac
        shift
    done

    if [ "$_ow" = 1 ]; then
        [ $# -eq 2 ] || die "usage: bpm verify --overwrite <pkg> <path>"
        as_root "$BPM_SELF" __restore "$1" "$2"
        return 0
    fi

    if [ $# -eq 0 ]; then
        for _d in "$BPM_DB"/*/; do
            [ -f "$_d/version" ] || continue
            _d=${_d%/}
            set -- "$@" "${_d##*/}"
        done
    else
        for _p; do pkg_installed "$_p" || die "$_p is not installed"; done
    fi

    _st=0
    for _p; do pkg_verify "$_p" || _st=1; done
    if [ "$BPM_VERIFY_NOSUMS" -gt 0 ]; then
        warn "$BPM_VERIFY_NOSUMS package(s) lack checksums and cannot be verified."
    fi
    if [ "$_st" = 0 ]; then msg "no mismatches"; fi
    return "$_st"
}

cmd_files() {
    [ $# -gt 0 ] || usage
    pkg_installed "$1" || die "$1 is not installed"
    sort "$BPM_DB/$1/manifest"
}

cmd_owns() {
    [ $# -gt 0 ] || usage
    case $1 in
        /*) _f=$1 ;;
        *)  _f=$(cd "$(dirname "$1")" && pwd)/$(basename "$1") ;;
    esac
    _o=$(pkg_owner "$_f")
    [ -n "$_o" ] || die "no package owns $_f"
    printf '%s\n' "$_o"
}

cmd_checksum() {
    _w=0
    if [ "${1:-}" = -w ]; then _w=1; shift; fi
    [ $# -gt 0 ] || usage
    tmpl_load "$1"
    src_fetch
    _sums=
    for _d in ${dist_files:-}; do
        case $_d in git+*) _sums="$_sums SKIP"; continue ;; esac
        _sums="$_sums $(blake3 "$src_dir/$(dist_name "$_d")")"
    done
    _sums=${_sums# }
    if [ "$_w" = 1 ]; then
        sed "s|^checksum=.*|checksum=\"$_sums\"|" "$tmpl_dir/template" > "$tmpl_dir/template.new"
        mv -f "$tmpl_dir/template.new" "$tmpl_dir/template"
        msg "checksum updated in $tmpl_dir/template"
    else
        printf 'checksum="%s"\n' "$_sums"
    fi
}

cmd_download() {
    [ $# -gt 0 ] || usage
    for _p; do tmpl_load "$_p"; src_fetch; src_verify; done
}

cmd_log() {
    if [ $# -eq 0 ]; then
        for _f in "$BPM_LOGDIR"/*.log; do
            [ -f "$_f" ] || die "no build logs in $BPM_LOGDIR"
            _n=${_f##*/}
            printf '%s\n' "${_n%.log}"
        done
        return 0
    fi
    _f=$BPM_LOGDIR/$1.log
    [ -f "$_f" ] || die "no build log for $1 (looked at $_f)"
    if [ -t 1 ] && [ -n "${PAGER:-}" ]; then "$PAGER" "$_f"; else cat "$_f"; fi
}

cmd_clean() {
    msg "cleaning build trees"
    rm -rf "${BPM_CACHE:?}/build" "${BPM_CACHE:?}/dest" "${BPM_CACHE:?}/tmp"
    if [ -n "$BPM_BUILDROOT" ]; then
        if [ "${1:-}" = all ]; then
            msg "removing the build root base"
            rm -rf "${BPM_BUILDROOT:?}"
        else
            for _c in "$BPM_BUILDROOT"/*/; do
                case ${_c%/} in */base) continue ;; esac
                [ -d "$_c" ] && rm -rf "$_c" || :
            done
        fi
    fi
}

# populate the shared build root base, run inside the namespaces so that the
# unpacked files get the ownership they are supposed to have
cmd__base() {
    . "$BPM_LIBDIR/sandbox.sh"
    mkdir -p "$BPM_BUILDROOT"
    broot_base
}

# stage one: inside the namespaces, still on the hosts /
#
# assembles the build root and chroots into it, or gets out of the way when
# build roots are switched off
cmd__stage() {
    if [ -z "$BPM_BUILDROOT" ]; then cmd__build "$1"; return "$?"; fi
    . "$BPM_LIBDIR/sandbox.sh"
    broot_run "$1"
}

# stage two: inside the build root
cmd__build() {
    . "$BPM_LIBDIR/build.sh"
    build_run "$1"
}

# all of the flags here apply to every package that follows them so
# just 1 escalation can install what was requested and what came with it
# and still tell them apart
cmd__install() {
    _mode=explicit
    for _a; do
        case $_a in
            --explicit|--auto|--keep) _mode=${_a#--}; continue ;;
        esac
        pkg_install "$_a"
        pkg_mark_installed "$(ar_name "$_a")" "$_mode"
    done
}
cmd__remove() { for _p; do pkg_remove "$_p"; done; }
cmd__swap() { pkg_swap "$1" "$2"; }
cmd__restore() { pkg_restore "$1" "$2"; }

while [ $# -gt 0 ]; do
    case $1 in
        -v|--verbose) BPM_VERBOSE=1 ;;
        -q|--quiet) BPM_VERBOSE=0 ;;
        --help|--version) break ;;
        --) shift; break ;;
        -*) die "unknown option: $1 (try 'bpm help')" ;;
        *) break ;;
    esac
    shift
done
export BPM_VERBOSE

[ $# -gt 0 ] || usage
cmd=$1
shift

case $cmd in
    b|build) cmd_build "$@" ;;
    i|install) cmd_install "$@" ;;
    r|remove) cmd_remove "$@" ;;
    autoremove) cmd_autoremove "$@" ;;
    u|update) cmd_update "$@" ;;
    p|pull) cmd_pull "$@" ;;
    s|search) cmd_search "$@" ;;
    q|query) cmd_query "$@" ;;
    a|alternatives) cmd_alternatives "$@" ;;
    l|list) cmd_list "$@" ;;
    f|files) cmd_files "$@" ;;
    o|owns) cmd_owns "$@" ;;
    c|checksum) cmd_checksum "$@" ;;
    d|download) cmd_download "$@" ;;
    verify) cmd_verify "$@" ;;
    log) cmd_log "$@" ;;
    clean) cmd_clean "$@" ;;
    v|version|--version) printf 'bpm %s\n' "$BPM_PROGVER" ;;
    h|help|--help) usage 0 ;;
    __base) cmd__base "$@" ;;
    __stage) cmd__stage "$@" ;;
    __build) cmd__build "$@" ;;
    __install) cmd__install "$@" ;;
    __remove) cmd__remove "$@" ;;
    __swap) cmd__swap "$@" ;;
    __restore) cmd__restore "$@" ;;
    *) die "unknown command: $cmd (try 'bpm help')" ;;
esac
